#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "RayPayload.glsl"

struct CallableData
{
    vec4 Result;
    uint Guard;
};

layout(binding = 1, rgba32f) uniform image2D AccumulationImage;
layout(binding = 2, rgba32f) uniform image2D OutputImage;
layout(location = 0) rayPayloadEXT RayPayload Ray;
layout(location = 1) callableDataEXT CallableData Call;

void main()
{
    Ray.ColorAndDistance = vec4(0.0625, 0.125, 0.1875, 0.25);
    Ray.ScatterDirection = vec4(0.3125, 0.375, 0.4375, 0.5);
    Ray.SurfaceNormal = vec3(0.5625, 0.625, 0.6875);
    Ray.RandomSeed = 0xabcdef01u;
    Call.Result = vec4(0.0);
    Call.Guard = 0x13579bdfu;

    executeCallableEXT(0, 1);

    // Encode both the callable return value and the original payload into the
    // rendered pixel.  Any callable-data/payload alias or failed return changes
    // the acceptance color without introducing control-flow phis.
    const vec4 payloadDelta =
        Ray.ColorAndDistance - vec4(0.0625, 0.125, 0.1875, 0.25);
    const vec4 color = vec4(Call.Result.xyz + payloadDelta.xyz, 0.0);
    imageStore(AccumulationImage, ivec2(gl_LaunchIDEXT.xy), color);
    imageStore(OutputImage, ivec2(gl_LaunchIDEXT.xy), color);
}
