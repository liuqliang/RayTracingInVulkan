#version 460
#extension GL_EXT_ray_tracing : require
#extension GL_GOOGLE_include_directive : require

#include "UniformBufferObject.glsl"

struct SequentialPayload
{
    vec4 Result;
    uint Phase;
    uint VisitedMask;
    uint Error;
};

layout(binding = 0, set = 0) uniform accelerationStructureEXT Scene;
layout(binding = 1, rgba32f) uniform image2D AccumulationImage;
layout(binding = 2, rgba32f) uniform image2D OutputImage;
layout(binding = 3) readonly uniform UniformBufferObjectStruct { UniformBufferObject Camera; };
layout(location = 0) rayPayloadEXT SequentialPayload Ray;

void main()
{
    const vec4 origin = Camera.ModelViewInverse * vec4(0, 0, 0, 1);
    const vec4 target = Camera.ProjectionInverse * vec4(0, 0, 1, 1);
    const vec4 direction = Camera.ModelViewInverse * vec4(normalize(target.xyz), 0);

    Ray.Result = vec4(0.0);
    Ray.Phase = 0u;
    Ray.VisitedMask = 0u;
    Ray.Error = 0u;
    traceRayEXT(Scene, gl_RayFlagsOpaqueEXT, 0xff,
                0, 0, 0, origin.xyz, 0.001, direction.xyz, 10000.0, 0);
    const uint firstMask = Ray.VisitedMask;
    const vec3 firstResult = Ray.Result.xyz;

    Ray.Phase = 1u;
    traceRayEXT(Scene, gl_RayFlagsOpaqueEXT, 0xff,
                0, 0, 0, vec3(2000000.0), 0.001,
                vec3(0.0, 1.0, 0.0), 1.0, 0);
    if (firstMask != 1u)
        Ray.Error = 1u;
    if (!all(equal(firstResult, vec3(0.125, 0.25, 0.5))))
        Ray.Error = 1u;
    if (Ray.VisitedMask != 3u)
        Ray.Error = 1u;
    if (!all(equal(Ray.Result.xyz, vec3(0.625, 0.5, 0.625))))
        Ray.Error = 1u;
    const bool valid = Ray.Error == 0u;
    const vec4 color = valid
        ? vec4(Ray.Result.xyz, 0.0)
        : vec4(1.0, 0.0, 1.0, 0.0);
    imageStore(AccumulationImage, ivec2(gl_LaunchIDEXT.xy), color);
    imageStore(OutputImage, ivec2(gl_LaunchIDEXT.xy), color);
}
